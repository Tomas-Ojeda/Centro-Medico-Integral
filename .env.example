# ══════════════════════════════════════════════════════════════
# CENTRO MÉDICO — Variables de entorno (EJEMPLO)
# ══════════════════════════════════════════════════════════════
# IMPORTANTE: Copiar este archivo a .env y rellenar con tus valores reales


# ── Django ────────────────────────────────────────────────────
# Generá una key segura corriendo:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=tu-secret-key-aqui

DJANGO_DEBUG=False

# IP de la PC del centro en la red local (ejecutá "ipconfig" en Windows para verla)
# Ejemplo: 192.168.1.100
# Podés poner varias separadas por coma: 192.168.1.100,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.x.x

# ── Base de datos PostgreSQL ──────────────────────────────────
DB_NAME=centromedico
DB_USER=centromedico_user
DB_PASSWORD=tu-contraseña-segura-aqui
DB_HOST=db
DB_PORT=5432

# ── API de Anthropic (para importar planillas con foto) ───────
# Obtené tu key en: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=tu-api-key-aqui