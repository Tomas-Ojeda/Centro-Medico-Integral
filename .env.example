# ─── Base de datos ──────────────────────────────────────────────
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña_segura

# ─── Django ─────────────────────────────────────────────────────
# Generar una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=PONE_TU_SECRET_KEY_SEGURA_ACA
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# ─── Cookies seguras (activar en producción con HTTPS) ─────────
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# ─── Expiración de sesión ──────────────────────────────────────
SESSION_COOKIE_AGE=3600

# ─── API de Anthropic (para importación de planillas) ──────────
ANTHROPIC_API_KEY=

# ─── Anotaciones clínicas ──────────────────────────────────────
# True: Recepción puede ver las anotaciones (también en el PDF).
# False: Recepción no ve la tarjeta ni las notas en el PDF.
NOTAS_VISIBLES_PARA_RECEPCION=True

# ─── pgAdmin (solo desarrollo local) ───────────────────────────
PGADMIN_EMAIL=tu_email@ejemplo.com
PGADMIN_PASSWORD=tu_contraseña_segura

# ─── pgAdmin (solo desarrollo local) ───────────────────────────
PGADMIN_EMAIL=tu_email@ejemplo.com
PGADMIN_PASSWORD=tu_contraseña_segura
